{
  "name": "graak",
  "version": "1.0.0",
  "description": "Package JavaScript and TypeScript programs (servers, websites, CLIs, bots) into standalone executables for every device, including legacy Windows and 32-bit systems, on Graak's own engine or Node.js",
  "homepage": "https://github.com/ariel-aram/graak#readme",
  "bugs": {
    "url": "https://github.com/ariel-aram/graak/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ariel-aram/graak.git"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./forgescript": {
      "types": "./dist/forgescript/index.d.ts",
      "default": "./dist/forgescript/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "graak": "dist/cli.js"
  },
  "files": [
    "dist",
    "metadata",
    "quickjs",
    "README.md",
    "tools"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "check": "biome check",
    "format": "biome format --write",
    "docgen": "tsc && node dist/forgescript/docgen.js",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "test": "tsc && node --test \"test/**/*.test.ts\"",
    "conformance": "node tools/engine-conformance.js",
    "prebuilts": "tsc && node tools/build-prebuilts.js"
  },
  "keywords": [
    "graak",
    "executable",
    "standalone",
    "binary",
    "packager",
    "quickjs",
    "sea",
    "legacy-windows",
    "windows7",
    "32bit",
    "ish",
    "static-site",
    "typescript",
    "forgescript"
  ],
  "author": "Ariel Aram",
  "license": "GPL-3.0-or-later",
  "engines": {
    "node": ">=20.12.0",
    "bun": ">=1.2.0"
  },
  "dependencies": {
    "abort-controller": "^3.0.0",
    "esbuild": "^0.28.2",
    "esbuild-wasm": "^0.28.2",
    "event-target-shim": "^6.0.2",
    "formdata-node": "^4.4.1",
    "postject": "1.0.0-alpha.6",
    "web-streams-polyfill": "^3.3.3"
  },
  "peerDependencies": {
    "@tryforge/forgescript": "^2.7.1"
  },
  "peerDependenciesMeta": {
    "@tryforge/forgescript": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@tryforge/forgescript": "^2.7.1",
    "@types/node": "^22.13.9",
    "nan": "^2.29.0",
    "tr46": "^5.1.1",
    "typescript": "^5.8.2",
    "webidl-conversions": "^7.0.0",
    "whatwg-url": "^14.2.0"
  }
}
